    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/alkalami": "^5.3.0",
    "@fontsource/almarai": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/aref-ruqaa-ink": "^5.3.0",
    "@fontsource/badeen-display": "^5.3.0",
    "@fontsource/blaka": "^5.3.0",
