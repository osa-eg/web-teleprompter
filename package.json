{
  "name": "web-teleprompter",
  "private": true,
  "version": "0.1.0",
  "description": "A full-featured web teleprompter with first-class Arabic (RTL) and font support.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0 && node scripts/check-logical-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "npm run fonts:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dist && npm run e2e",
    "fonts:gen": "node scripts/gen-font-catalog.mjs",
    "fonts:check": "node scripts/gen-font-catalog.mjs --check",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/arimo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource-variable/beiruti": "^5.3.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/cairo-play": "^5.3.0",
    "@fontsource-variable/changa": "^5.3.0",
    "@fontsource-variable/el-messiri": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/kufam": "^5.3.0",
    "@fontsource-variable/lemonada": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/mada": "^5.3.0",
    "@fontsource-variable/marhey": "^5.3.0",
    "@fontsource-variable/markazi-text": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
