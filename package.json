    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@fontsource/vibes": "^5.3.0",
    "@fontsource/zain": "^5.3.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
